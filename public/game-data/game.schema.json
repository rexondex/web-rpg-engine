{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/data-rpg/game.schema.json",
  "title": "Data-driven SSG RPG Game Protocol v1",
  "type": "object",
  "required": ["protocolVersion", "game", "player", "combat", "items", "monsters", "quests", "npcs", "dialogues", "maps"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "game": { "type": "object", "required": ["id", "title", "version", "autosaveSeconds"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "title": { "type": "string" }, "subtitle": { "type": "string" }, "version": { "type": "string" }, "autosaveSeconds": { "type": "number", "minimum": 1 } } },
    "player": { "type": "object", "required": ["name", "startMap", "startX", "startY", "baseStats", "xpCurve", "startingItems"], "properties": { "name": { "type": "string" }, "startMap": { "type": "string" }, "startX": { "type": "number" }, "startY": { "type": "number" }, "baseStats": { "$ref": "#/$defs/stats" }, "levelGrowth": { "$ref": "#/$defs/stats" }, "xpCurve": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2 }, "startingItems": { "$ref": "#/$defs/countMap" } } },
    "combat": { "type": "object", "required": ["attackCooldownMs", "invulnerabilityMs", "attackRange"], "properties": { "attackCooldownMs": { "type": "number", "minimum": 50 }, "invulnerabilityMs": { "type": "number", "minimum": 0 }, "attackRange": { "type": "number", "minimum": 1 } } },
    "items": { "type": "object", "additionalProperties": { "type": "object", "required": ["name", "description", "type", "maxStack", "value"], "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "type": { "enum": ["consumable", "quest", "material"] }, "maxStack": { "type": "integer", "minimum": 1 }, "value": { "type": "number", "minimum": 0 }, "actions": { "$ref": "#/$defs/actions" } } } },
    "monsters": { "type": "object", "additionalProperties": { "type": "object", "required": ["name", "texture", "stats", "speed", "aggroRange", "xp", "drops"], "properties": { "name": { "type": "string" }, "texture": { "enum": ["slime", "wolf"] }, "stats": { "$ref": "#/$defs/stats" }, "speed": { "type": "number", "minimum": 0 }, "aggroRange": { "type": "number", "minimum": 0 }, "xp": { "type": "number", "minimum": 0 }, "drops": { "type": "array", "items": { "type": "object", "required": ["itemId", "chance", "min", "max"], "properties": { "itemId": { "type": "string" }, "chance": { "type": "number", "minimum": 0, "maximum": 1 }, "min": { "type": "integer", "minimum": 0 }, "max": { "type": "integer", "minimum": 0 } } } } } } },
    "quests": { "type": "object", "additionalProperties": { "$ref": "#/$defs/quest" } },
    "npcs": { "type": "object", "additionalProperties": { "type": "object", "required": ["name", "color", "dialogue"], "properties": { "name": { "type": "string" }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "dialogue": { "type": "string" } } } },
    "dialogues": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dialogueNode" } } },
    "maps": { "type": "object", "additionalProperties": { "$ref": "#/$defs/map" } }
  },
  "$defs": {
    "stats": { "type": "object", "required": ["maxHp", "attack", "defense"], "properties": { "maxHp": { "type": "number", "minimum": 1 }, "attack": { "type": "number", "minimum": 0 }, "defense": { "type": "number", "minimum": 0 } } },
    "countMap": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "condition": { "type": "object", "required": ["type", "id", "value"], "properties": { "type": { "enum": ["questStatus", "objective", "level", "hasItem", "flag"] }, "id": { "type": "string" }, "value": {}, "operator": { "enum": ["eq", "gte", "lte"] } } },
    "action": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["startQuest", "completeQuest", "failQuest", "objective", "giveItem", "takeItem", "heal", "setFlag", "xp", "teleport"] }, "id": { "type": "string" }, "objectiveId": { "type": "string" }, "amount": { "type": "number" }, "value": { "type": "boolean" }, "mapId": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" } } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "dialogueNode": { "type": "object", "required": ["id", "speaker", "text"], "properties": { "id": { "type": "string" }, "speaker": { "type": "string" }, "text": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } }, "actions": { "$ref": "#/$defs/actions" }, "next": { "type": "string" }, "choices": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "next": { "type": "string" }, "actions": { "$ref": "#/$defs/actions" }, "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } } } } } } },
    "quest": { "type": "object", "required": ["title", "giver", "summary", "objectives", "rewards", "success", "failure"], "properties": { "title": { "type": "string" }, "giver": { "type": "string" }, "summary": { "type": "string" }, "objectives": { "type": "array", "items": { "type": "object", "required": ["id", "label", "type", "target", "targetId"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "type": { "enum": ["kill", "talk", "visit", "collect", "custom"] }, "target": { "type": "integer", "minimum": 1 }, "targetId": { "type": "string" } } } }, "rewards": { "type": "object", "properties": { "xp": { "type": "number", "minimum": 0 }, "items": { "$ref": "#/$defs/countMap" } } }, "success": { "type": "string" }, "failure": { "type": "string" } } },
    "map": { "type": "object", "required": ["name", "subtitle", "ground", "path", "spawn", "npcs", "exits", "spawns"], "properties": { "name": { "type": "string" }, "subtitle": { "type": "string" }, "ground": { "type": "string" }, "path": { "type": "string" }, "spawn": { "$ref": "#/$defs/point" }, "npcs": { "type": "array", "items": { "type": "object", "required": ["npcId", "x", "y"], "properties": { "npcId": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" } } } }, "exits": { "type": "array", "items": { "type": "object", "required": ["x", "y", "width", "height", "to", "spawnX", "spawnY", "label"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" }, "to": { "type": "string" }, "spawnX": { "type": "number" }, "spawnY": { "type": "number" }, "label": { "type": "string" } } } }, "spawns": { "type": "array", "items": { "type": "object", "required": ["id", "monsterId", "x", "y", "width", "height", "max", "respawnMs"], "properties": { "id": { "type": "string" }, "monsterId": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" }, "max": { "type": "integer", "minimum": 0 }, "respawnMs": { "type": "number", "minimum": 500 } } } } } },
    "point": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }
  }
}
